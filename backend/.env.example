ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://tasca:tasca@localhost:5432/tasca
SYNC_DATABASE_URL=postgresql+psycopg://tasca:tasca@localhost:5432/tasca
CORS_ORIGINS=http://localhost:5173

# Admin login. Generate the hash with: PYTHONPATH=src uv run python -m core.hash_password
# Keep the single quotes: argon2 hashes contain `$`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='paste-the-generated-hash-here'

# Signs login tokens. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-random-64-char-hex-string

# Shared secret the voice agent sends as X-Agent-Secret. Optional: while unset,
# every /api/v1/agent route answers 401. Generate with: openssl rand -hex 32
# AGENT_API_SECRET=

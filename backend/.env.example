ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://tasca:tasca@localhost:5432/tasca
SYNC_DATABASE_URL=postgresql+psycopg://tasca:tasca@localhost:5432/tasca
# Dashboard (5173) and customer website (5175). In production, both Netlify URLs.
CORS_ORIGINS=http://localhost:5173,http://localhost:5175

# Admin login. Generate the hash with: PYTHONPATH=src uv run python -m core.hash_password
# Keep the single quotes: argon2 hashes contain `$`.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH='paste-the-generated-hash-here'

# Signs login tokens. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-random-64-char-hex-string

# Shared secret the voice agent sends as X-Agent-Secret. Optional: while unset,
# every /api/v1/agent route answers 401. Generate with: openssl rand -hex 32
# AGENT_API_SECRET=

# Secret shown by ElevenLabs when you create the post-call webhook. Optional: while
# unset, every webhook is rejected (401).
# ELEVENLABS_WEBHOOK_SECRET=

# For the website's "Talk to Tasca" button (POST /api/v1/voice/session). The key
# needs ElevenAgents access only. Optional: while unset, that route answers 503.
# ELEVENLABS_API_KEY=
# ELEVENLABS_AGENT_ID=agent_...

# "Explore as a guest" on the dashboard (read-only, phones masked). Default true;
# set to false to turn it off.
# GUEST_ACCESS_ENABLED=true
